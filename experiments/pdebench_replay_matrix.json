{
  "protocol_version": "2026-08-05-pdebench-replay-v1",
  "role": "External-trajectory replay stress test; not a physical-solver benchmark",
  "scope": "Training-free methods only",
  "seed_base": 2026080600,
  "methods": ["hilda", "denkf", "letkf", "ensf", "iensf", "ensf_lr_ridge", "enff_f2p"],
  "data": {
    "dataset": "PDEBench NS_Incom",
    "root": "data/pdebench/2D/NS_incom",
    "filename_template": "ns_incom_inhom_2d_512-{file_index}.h5",
    "file_indices": [0, 1, 2, 3, 4],
    "trajectory_indices": [0, 1, 2, 3],
    "source_grid": [512, 512],
    "channels": ["velocity_x", "velocity_y"],
    "manifest": "external/PDEBench/pdebench/data_download/pdebench_data_urls.csv",
    "collection_validation": "data/pdebench/ns_incom_collection_validation.json"
  },
  "replay_protocol": {
    "time_start": 0,
    "time_stop": 1000,
    "time_step": 10,
    "cycle_count": 100,
    "spatial_stride": 4,
    "assimilation_grid": [128, 128],
    "forecast_model": "linear_extrapolation",
    "future_target_frames_used_by_forecast": false,
    "ensemble_size": 20,
    "sensor_count": 64,
    "scalar_observation_count": 128,
    "observation_noise": 0.1,
    "observation_transform": "atan",
    "normalization": "none",
    "initial_spread": 0.05,
    "process_noise": 0.01,
    "noise_smoothing_radius": 4,
    "hilda_path_log_scale": 0.35,
    "coverage_level": 0.9,
    "energy_score_chunk_size": 64,
    "dtype": "float32",
    "checkpoint_interval": 1
  },
  "metric_applicability": {
    "all_methods": ["state_rmse", "observation_rmse", "crps", "energy_score", "coverage", "interval_width", "cycle_seconds", "peak_gpu_memory_bytes"],
    "hilda_diagnostic_only": ["liu_coordinate_estimate", "active_path_count"],
    "unavailable": ["alpha_true", "alpha_rmse", "alpha_absolute_error"]
  },
  "result_root": "results/pdebench_replay_v1"
}
